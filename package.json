{
  "name": "singularity",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:app": "npm run dev --workspace @singularity/app",
    "dev:landing": "npm run dev --workspace @singularity/landing",
    "dev:x-reply-agent": "npm run dev --workspace @singularity/x-reply-agent",
    "build": "turbo build",
    "build:app": "npm run build --workspace @singularity/app",
    "build:landing": "npm run build --workspace @singularity/landing",
    "db:migrate": "npm run migrate --workspace @singularity/db",
    "security:gate": "node scripts/security-gate.mjs",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "test:anchor": "ts-mocha -p ./tsconfig.anchor.json -t 1000000 \"tests/**/*.ts\"",
    "test:anchor:local": "node scripts/anchor-test-local.mjs",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@types/mocha": "^10.0.10",
    "mocha": "^11.3.0",
    "serialize-javascript": "^7.0.5",
    "ts-mocha": "^11.1.0",
    "turbo": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.26.1",
    "@solana-program/memo": "^0.11.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "next": "^16.2.6",
    "vite": "^8.0.13"
  },
  "overrides": {
    "@solana/kit": "6.9.0"
  }
}
