DATABASE_URL=postgres://user:password@host:5432/singularity
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SINGULARITY_STORAGE=postgres
SINGULARITY_SESSION_SECRET=replace-with-a-long-random-secret
SINGULARITY_PUBLIC_APP_URL=https://app.singularity.diy
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY= # optional PEM key from Privy dashboard, not the JWKS URL
# Privy gas sponsorship for embedded (email-login) Solana wallets.
# Enabled by default in code. Set to false to disable. Also enable in Privy Dashboard → Gas Sponsorship → Solana mainnet.
# NEXT_PUBLIC_PRIVY_GAS_SPONSORSHIP_ENABLED=false
SINGULARITY_GAS_SPONSOR_DAILY_LIMIT=50
# Optional comma-separated override. Defaults to Singularity registry/council + core Solana programs.
SINGULARITY_GAS_SPONSOR_PROGRAM_IDS=
# Base58 secret key for the server fee payer that sponsors mission launch and council registration for embedded wallets.
SINGULARITY_LAUNCH_FEE_PAYER_KEYPAIR=
SINGULARITY_REGISTRY_PROGRAM_ID=7CxZRBgnYwi5MtSKebmaSh7XTRVXk3QgzjXRUgLzcXT5
SINGULARITY_COUNCIL_PROGRAM_ID=4k7JhCHjs2uoiP1hmvYDawnwJuXMt5ZhUJotvMRqedKS
SINGULARITY_METEORA_DBC_PROGRAM_ID=dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN
SINGULARITY_COUNCIL_AUTHORITY_PUBKEY=
SINGULARITY_COUNCIL_AUTHORITY_KEYPAIR=
SINGULARITY_COUNCIL_EXCLUDED_OWNERS=
SINGULARITY_COUNCIL_EXCLUDED_TOKEN_ACCOUNTS=
SINGULARITY_PLATFORM_FEE_RECIPIENT=
SINGULARITY_FEE_DISTRIBUTOR_PUBKEY=
SINGULARITY_FEE_DISTRIBUTOR_KEYPAIR=
CRON_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=

# Reddit outreach agent (apps/reddit-outreach-agent)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=SingularityOutreach/0.1 by u/your_username
REDDIT_SESSION_COOKIE=
REDDIT_OUTREACH_POST_URL=
REDDIT_OUTREACH_DRY_RUN=true
REDDIT_OUTREACH_ENABLE_SEND=false
REDDIT_OUTREACH_MAX_PER_RUN=5
REDDIT_OUTREACH_MAX_COMMENTS=200
REDDIT_OUTREACH_MIN_CONFIDENCE=0.55
REDDIT_OUTREACH_SEND_DELAY_MS=15000
REDDIT_OUTREACH_STATE_PATH=.singularity/reddit-outreach-agent-state.json
REDDIT_OUTREACH_MISSION_API_KEY=
REDDIT_OUTREACH_MISSION_API_BASE_URL=https://api.openai.com/v1
REDDIT_OUTREACH_MISSION_MODEL=gpt-4o-mini

# X founder outreach agent (apps/x-reply-agent)
X_BEARER_TOKEN=
X_USER_ACCESS_TOKEN=
X_OUTREACH_POST_URL=
X_REPLY_SOURCE_POST_IDS=
X_OUTREACH_DRY_RUN=true
X_OUTREACH_ENABLE_DM=true
X_OUTREACH_ENABLE_QUOTE=false
X_OUTREACH_MAX_PER_RUN=5
X_OUTREACH_SCAN_MULTIPLIER=10
X_OUTREACH_MAX_REPLIES=
X_OUTREACH_MIN_CONFIDENCE=0.55
X_OUTREACH_SEND_DELAY_MS=15000
X_REPLY_REQUEST_DELAY_MS=1000
X_OUTREACH_STATE_PATH=.singularity/x-outreach-agent-state.json
X_OUTREACH_MISSION_API_KEY=
X_OUTREACH_MISSION_API_BASE_URL=https://api.openai.com/v1
X_OUTREACH_MISSION_MODEL=gpt-4o-mini
